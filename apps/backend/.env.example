# Points at the Postgres container started by the root docker-compose.yml.
# Match the credentials to the root .env if you changed them from the defaults.
DATABASE_URL="postgresql://teamcart:teamcart_dev_password@localhost:5432/teamcart"

# Used to sign JWTs — use a long random string, never a real secret in shared repos.
# Generate one locally, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET="replace_with_a_long_random_string"
JWT_REFRESH_SECRET="replace_with_a_different_long_random_string"

PORT=4000

# Stretch goal (Stripe test mode) — leave blank until docs/issues/06-cart-checkout.md's stretch section
STRIPE_SECRET_KEY=
