# Root-level env — used by docker-compose.yml for the local Postgres container.
# Copy this file to .env and adjust if you want different local credentials.
# apps/backend has its OWN .env.example too (DATABASE_URL there must match these values).

POSTGRES_USER=teamcart
POSTGRES_PASSWORD=teamcart_dev_password
POSTGRES_DB=teamcart
POSTGRES_PORT=5432
